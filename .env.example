# Application. APP_ENV must be explicit; only dev exposes the fixed local development session.
APP_ENV=prod
APP_ORIGIN=http://localhost:3000
LOG_LEVEL=info

# PostgreSQL and Redis. DATABASE_URL is the application database and may be used by
# the web, worker, or migration role; grant each deployment only the permissions it needs.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/debate_analyser
REDIS_URL=redis://localhost:6379
# Migration certification has no fallback. Set this only when running db:migrate:verify,
# point it at a dedicated test PostgreSQL administrator database (commonly /postgres),
# and never point it at DATABASE_URL or a production cluster.
# MIGRATION_TEST_ADMIN_URL=postgresql://postgres:postgres@localhost:5432/postgres

# External OIDC identity provider. Use a confidential Regular Web Application.
AUTH_ISSUER=https://identity.example.com/
AUTH_AUDIENCE=debate-analyser
AUTH_JWKS_URL=https://identity.example.com/.well-known/jwks.json
AUTH_CLIENT_ID=replace-with-development-oidc-client-id
AUTH_CLIENT_SECRET=replace-with-development-oidc-client-secret

# Generate at least 32 random characters; never commit the real value.
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
SESSION_COOKIE_NAME=debate_session

# Provisional, configurable Phase-06.02 operational defaults; calibrate in Phase 07.
EVENT_RETENTION_SECONDS=86400
EVENT_REPLAY_LIMIT=1000
RATE_LIMIT_A_PER_HOUR=10
RATE_LIMIT_B_PER_HOUR=120
RATE_LIMIT_C_PER_HOUR=600
RATE_LIMIT_D_CONCURRENT=30
RATE_LIMIT_D_LEASE_SECONDS=120
RATE_LIMIT_P_PER_HOUR=120

# F1a legal gate. Keep approval false until counsel approves the exact published version.
# Development test mode is accepted only with APP_ENV=dev and never counts as counsel approval.
LEGAL_POLICY_VERSION=2026-07-27.draft-1
LEGAL_COUNSEL_APPROVED=false
LEGAL_DEVELOPMENT_TEST_MODE=false
LEGAL_ALLOW_UPLOADS=false
LEGAL_ALLOW_PASTE=false
LEGAL_ALLOWED_URL_HOSTS=
LEGAL_BLOCKED_URL_HOSTS=
LEGAL_OFFICIAL_API_REQUIRED_HOSTS=youtube.com,www.youtube.com,youtu.be

# M10 publication controls. All features default off independently. Public sharing and
# report export require publication approval; account-data export has its own independent gate.
PUBLIC_SHARING_ENABLED=false
REPORT_EXPORT_ENABLED=false
ACCOUNT_DATA_EXPORT_ENABLED=false
# PDF rendering is intentionally unsupported; HTML and JSON are the only export formats.
PDF_EXPORT_ENABLED=false
PUBLICATION_COUNSEL_APPROVED=false
PUBLICATION_POLICY_VERSION=
DISCLAIMER_VERSION=
LIMITATIONS_URL=

# F1 ingest limits and S3-compatible object storage. A bucket is required only when
# uploads or export features that use object storage are enabled. Leave access keys empty
# when the runtime receives short-lived credentials from its cloud workload identity.
INGEST_MAX_UPLOAD_BYTES=524288000
INGEST_MAX_PASTE_CHARS=1000000
UPLOAD_URL_TTL_SECONDS=900
IDEMPOTENCY_TTL_SECONDS=86400
OBJECT_STORAGE_BUCKET=debate-analyser
OBJECT_STORAGE_REGION=us-east-1
# Optional for S3-compatible services; omit for AWS S3.
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
OBJECT_STORAGE_FORCE_PATH_STYLE=false
OBJECT_DOWNLOAD_URL_TTL_SECONDS=900

# F2 transcription worker. Configure ASR_PROVIDER=whisper for local Whisper inference (zero API cost)
# or ASR_PROVIDER=deepgram for cloud Deepgram.
TRANSCRIPT_TEXT_MAX_BYTES=26214400
ASR_PROVIDER=deepgram
WHISPER_URL=http://localhost:5001/transcribe
WHISPER_TIMEOUT_MS=600000
DEEPGRAM_API_KEY=
DEEPGRAM_API_URL=https://api.deepgram.com/v1/listen
DEEPGRAM_MODEL=nova-3
DEEPGRAM_DIARIZATION_MODEL=v2
ASR_TIMEOUT_MS=600000
ASR_LOW_CONFIDENCE_THRESHOLD=0.8
DIARIZATION_LOW_CONFIDENCE_THRESHOLD=0.8
WORKER_JOB_LEASE_SECONDS=900
WORKER_POLL_INTERVAL_MS=1000
WORKER_MAX_ATTEMPTS=3
# Maximum time for each database or Redis readiness probe.
HEALTHCHECK_TIMEOUT_MS=3000

# F3 claim extraction through Groq's OpenAI-compatible Responses API
# (disabled until provider credentials and rollout approval are present).
# Set CLAIM_PROVIDER=ollama to use a local Ollama instance instead of Groq.
CLAIM_EXTRACTION_ENABLED=false
CLAIM_PROVIDER=openai
GROQ_API_KEY=
OPENAI_RESPONSES_URL=https://api.groq.com/openai/v1/responses
# Ollama local inference (no API key required)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=phi3:mini
# OLLAMA_NUM_CTX=2048
# OLLAMA_NUM_GPU=0
# OLLAMA_REQUEST_TIMEOUT_MS=300000
CLAIM_MODEL=openai/gpt-oss-120b
CLAIM_PROMPT_VERSION=s2-claim-extraction-v1
CLAIM_SCHEMA_VERSION=s2-claim-schema-v1
CLAIM_REQUEST_TIMEOUT_MS=120000
CLAIM_WINDOW_MAX_CHARS=30000
CLAIM_WINDOW_OVERLAP_SEGMENTS=2
CLAIM_MAX_CLAIMS_PER_WINDOW=50
CLAIM_MAX_OUTPUT_TOKENS=8000
CLAIM_SCHEMA_MAX_ATTEMPTS=3

# F4 speaker-provided support assessment (disabled until calibrated rollout approval)
SUPPORT_ASSESSMENT_ENABLED=false
SUPPORT_PROVIDER=openai
SUPPORT_MODEL=openai/gpt-oss-120b
SUPPORT_PROMPT_VERSION=s3-support-assessment-v1
SUPPORT_SCHEMA_VERSION=s3-support-schema-v1
SUPPORT_REQUEST_TIMEOUT_MS=120000
SUPPORT_CONTEXT_MAX_CHARS=100000
SUPPORT_MAX_CLAIMS_PER_CALL=20
SUPPORT_MAX_OUTPUT_TOKENS=8000
SUPPORT_SCHEMA_MAX_ATTEMPTS=3

# F5 Toulmin argument-structure mapping through Groq's OpenAI-compatible Responses API
# (disabled pending evaluation and workspace release)
ARGUMENT_STRUCTURE_ENABLED=false
STRUCTURE_PROVIDER=openai
STRUCTURE_MODEL=openai/gpt-oss-120b
STRUCTURE_PROMPT_VERSION=s4-toulmin-structure-v1
STRUCTURE_SCHEMA_VERSION=s4-toulmin-schema-v1
STRUCTURE_REQUEST_TIMEOUT_MS=120000
STRUCTURE_CONTEXT_MAX_CHARS=100000
STRUCTURE_MAX_CLAIMS_PER_CALL=10
STRUCTURE_MAX_NODES_PER_CLAIM=20
STRUCTURE_MAX_EDGES_PER_CLAIM=40
STRUCTURE_MAX_OUTPUT_TOKENS=8000
STRUCTURE_SCHEMA_MAX_ATTEMPTS=3

# F6 verified external evidence retrieval. Configure EVIDENCE_RETRIEVER_PROVIDER=wikipedia
# for zero-cost Wikipedia retrieval and EVIDENCE_VERIFIER_PROVIDER=ollama for local Ollama verification,
# or EVIDENCE_RETRIEVER_PROVIDER=http and EVIDENCE_VERIFIER_PROVIDER=openai for cloud services.
EVIDENCE_RETRIEVAL_ENABLED=false
EVIDENCE_RETRIEVER_PROVIDER=wikipedia
WIKIPEDIA_API_URL=https://en.wikipedia.org/w/api.php
WIKIPEDIA_USER_AGENT=DebateAnalyser-EvidenceVerifier/1.0 (https://github.com/Mohammed-Ayyan/DebateAnylyser; contact: local-analyser@debate.local)
EVIDENCE_RETRIEVER_URL=
EVIDENCE_RETRIEVER_API_KEY=
EVIDENCE_RETRIEVER_TIMEOUT_MS=20000
EVIDENCE_MAX_CANDIDATES_PER_CLAIM=5
EVIDENCE_VERIFIER_PROVIDER=ollama
EVIDENCE_VERIFIER_MODEL=gpt-5.6
EVIDENCE_PROMPT_VERSION=s6-evidence-verification-v1
EVIDENCE_SCHEMA_VERSION=s6-evidence-schema-v1
EVIDENCE_VERIFIER_TIMEOUT_MS=120000
EVIDENCE_MAX_OUTPUT_TOKENS=2000
EVIDENCE_SCHEMA_MAX_ATTEMPTS=3
EVIDENCE_SOURCE_FETCH_TIMEOUT_MS=15000
EVIDENCE_SOURCE_MAX_BYTES=2097152
EVIDENCE_SOURCE_MAX_REDIRECTS=3

# F17 possible fallacy/rhetoric detection through Groq's OpenAI-compatible Responses API
# (disabled pending precision calibration and XC review)
FALLACY_DETECTION_ENABLED=false
FALLACY_PROVIDER=openai
FALLACY_MODEL=openai/gpt-oss-120b
FALLACY_PROMPT_VERSION=s5-fallacy-detection-v1
FALLACY_SCHEMA_VERSION=s5-fallacy-schema-v1
FALLACY_REQUEST_TIMEOUT_MS=120000
FALLACY_MAX_FINDINGS=25
FALLACY_MAX_OUTPUT_TOKENS=2000
FALLACY_SCHEMA_MAX_ATTEMPTS=3
FALLACY_PRECISION_THRESHOLD=0.9

# F7 categorical source credibility signals. Set SOURCE_CREDIBILITY_PROVIDER=dataset
# to use the open transparent domain metadata dataset (zero API cost), or http for external rater API.
SOURCE_CREDIBILITY_ENABLED=false
SOURCE_CREDIBILITY_PROVIDER=dataset
CREDIBILITY_PROVIDER_URL=
CREDIBILITY_PROVIDER_API_KEY=
CREDIBILITY_PROVIDER_TIMEOUT_MS=20000

# Runtime entry points validate one explicit role: web, analysis-worker, m10-worker,
# or migration. Roles are command arguments, not an environment variable; see
# docs/deployment.md. Disabled features intentionally do not require provider secrets.