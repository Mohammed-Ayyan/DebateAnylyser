{
  "name": "debate-analyser",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": ">=24.0.0 <25.0.0",
    "npm": ">=11.0.0 <12.0.0"
  },
  "scripts": {
    "dev": "node scripts/run-next.mjs dev",
    "build": "node scripts/run-next.mjs build",
    "runtime:check": "node --import tsx scripts/runtime-check.ts",
    "start": "npm run runtime:check -- web && node scripts/run-next.mjs start",
    "worker": "node --use-system-ca --conditions=react-server --import tsx scripts/analysis-worker.ts",
    "worker:once": "node --use-system-ca --conditions=react-server --import tsx scripts/analysis-worker.ts --once",
    "worker:m10": "node --conditions=react-server --import tsx scripts/m10-worker.ts",
    "worker:m10:once": "node --conditions=react-server --import tsx scripts/m10-worker.ts --once",
    "workers:smoke": "node --conditions=react-server --import tsx scripts/worker-import-smoke.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest --run",
    "test:coverage": "vitest --run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:auth:real": "node --import tsx scripts/certify-auth-browser.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "npm run runtime:check -- migration && drizzle-kit migrate",
    "db:migrate:verify": "node --import tsx scripts/verify-migrations.ts",
    "db:check": "drizzle-kit check",
    "quality": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run db:check",
    "check": "npm run quality && npm run workers:smoke && npm run build"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1095.0",
    "@aws-sdk/s3-request-presigner": "3.1095.0",
    "@hookform/resolvers": "^3.9.1",
    "@radix-ui/react-accordion": "1.2.12",
    "@radix-ui/react-alert-dialog": "1.1.15",
    "@radix-ui/react-aspect-ratio": "1.1.8",
    "@radix-ui/react-avatar": "1.1.11",
    "@radix-ui/react-checkbox": "1.3.3",
    "@radix-ui/react-collapsible": "1.1.12",
    "@radix-ui/react-context-menu": "2.2.16",
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-dropdown-menu": "2.1.16",
    "@radix-ui/react-hover-card": "1.1.15",
    "@radix-ui/react-label": "2.1.8",
    "@radix-ui/react-menubar": "1.1.16",
    "@radix-ui/react-navigation-menu": "1.2.14",
    "@radix-ui/react-popover": "1.1.15",
    "@radix-ui/react-progress": "1.1.8",
    "@radix-ui/react-radio-group": "1.3.8",
    "@radix-ui/react-scroll-area": "1.2.10",
    "@radix-ui/react-select": "2.2.6",
    "@radix-ui/react-separator": "1.1.8",
    "@radix-ui/react-slider": "1.3.6",
    "@radix-ui/react-slot": "1.2.4",
    "@radix-ui/react-switch": "1.2.6",
    "@radix-ui/react-tabs": "1.1.13",
    "@radix-ui/react-toast": "1.2.15",
    "@radix-ui/react-toggle": "1.1.10",
    "@radix-ui/react-toggle-group": "1.1.11",
    "@radix-ui/react-tooltip": "1.2.8",
    "@vercel/analytics": "1.6.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "autoprefixer": "^10.4.20",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.1.0",
    "driver.js": "1.8.0",
    "drizzle-orm": "0.45.2",
    "embla-carousel-react": "8.6.0",
    "framer-motion": "^12.34.1",
    "geist": "^1.7.0",
    "input-otp": "1.4.2",
    "ioredis": "5.11.1",
    "jose": "6.2.4",
    "lucide-react": "^0.564.0",
    "mammoth": "1.12.0",
    "next": "16.2.12",
    "next-themes": "^0.4.6",
    "pdf-parse": "2.4.5",
    "postgres": "3.4.9",
    "react": "19.2.4",
    "react-day-picker": "9.13.2",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.54.1",
    "react-resizable-panels": "^2.1.7",
    "recharts": "2.15.0",
    "server-only": "0.0.1",
    "sonner": "^1.7.1",
    "tailwind-merge": "^3.3.1",
    "tsx": "4.23.1",
    "vaul": "^1.1.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "16.2.12",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "^4.1.13",
    "@types/node": "^22",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@typescript-eslint/eslint-plugin": "8.62.0",
    "@typescript-eslint/parser": "8.62.0",
    "@vitest/coverage-v8": "4.1.10",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.0.1",
    "globals": "16.4.0",
    "postcss": "^8.5",
    "prettier": "3.8.4",
    "tailwindcss": "^4.1.9",
    "tw-animate-css": "1.3.3",
    "typescript": "5.7.3",
    "vitest": "4.1.10"
  },
  "overrides": {
    "postcss": "$postcss",
    "sharp": "0.35.3"
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.1": true,
    "sharp@0.35.3": true
  }
}
